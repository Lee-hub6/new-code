# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进版本库。

# ---- 大模型引擎（最准）----
# DeepSeek API Key，设置后 --engine deepseek 可用。
# 获取地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Moonshot Kimi API Key，设置后 --engine kimi 可用。
# 获取地址：https://platform.moonshot.cn
MOONSHOT_API_KEY=

# ---- 第二档：小模型引擎（便宜）----
# 硅基流动的 Qwen 小模型，设置后 --engine small 可用。
# 注册地址：https://siliconflow.cn
SMALL_MODEL_API_KEY=

# ---- 第一档：离线引擎（零成本，无需配置）----
# 中文用 SnowNLP、英文用 VADER，完全离线可用

# ---- 可选参数（一般不用改）----
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# SMALL_MODEL_BASE_URL=https://api.siliconflow.cn/v1
# SMALL_MODEL_NAME=Qwen/Qwen3-8B
# BATCH_SIZE=20
